# Copy to .env (gitignored) and fill in what you use. Everything is optional;
# the base stack runs with none of these set.

# --- Tailscale-in-the-stack (docker-compose.tailscale.yml) -------------------
# Uncomment to make the override permanent: plain `docker compose up -d`
# then always includes it, so a forgotten -f flag can never quietly move
# the server back out of the tailscale node's network.
#COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml
# Auth key from https://login.tailscale.com/admin/settings/keys
# (reusable: no, ephemeral: no — this node should keep its identity).
TS_AUTHKEY=
# Name the box shows up as on your tailnet → https://kehai.<tailnet>.ts.net
TS_HOSTNAME=kehai
# Fill after the first start, once you know your tailnet name (see
# `docker compose logs tailscale`): the URL phones will reach ntfy at.
NTFY_PUBLIC_URL=

# --- Smart-home webhooks (deploy/README.md "Webhooks") -----------------------
KEHAI_WEBHOOK_URLS=
KEHAI_WEBHOOK_SECRET=

# --- Portal TURN relay (deploy/README.md "Portal mode") ----------------------
KEHAI_TURN_SECRET=
KEHAI_TURN_URLS=
