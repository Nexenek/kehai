<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The app talks to a self-hosted PocketBase server (HTTP + realtime
         WebSocket) over the couple's Tailscale tailnet or LAN. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Phase 2b presence.

         The foreground service keeps the background Dart isolate alive so
         the phone keeps reporting presence (battery/charging, screen-derived
         idle, now-playing) and keeps the partner-status notification fresh
         while Kehai is backgrounded — kb/platform-android.md, "24/7
         background operation".

         Type is specialUse, not dataSync: dataSync describes bounded
         transfer work and is capped at 6h/24h on Android 15+, which would
         make a companion-presence app go dark every afternoon. specialUse
         has no runtime prerequisites and no timeout; its only cost is Play
         review of the declared subtype, and Kehai is sideloaded/F-Droid.

         POST_NOTIFICATIONS is asked for at runtime on 13+; everything here
         is optional — each denied grant just means one signal fewer. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Only ever fired from the "phone superpowers" explainer screen,
         never unprompted. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- "Share my location" (kb/contracts.md "Location") — the app's own
         OwnTracks-compatible tracker, an alternative to running the
         separate OwnTracks app (which stays fully supported). Two-step
         honest grant: FINE/COARSE first via the normal runtime prompt,
         BACKGROUND_LOCATION as a separate later step opening system
         settings — same two-step shape as every other special-access grant
         on the superpowers screen. FOREGROUND_SERVICE_LOCATION lets the
         existing foreground service add the `location` type below so
         position updates keep flowing while the app is backgrounded. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <!-- "Focused-app status" (kb/features.md) — UsageStatsManager reads for
         the foreground-app signal. This permission is declared for
         documentation only: it's a signature/privileged permission normal
         apps can never hold, so the manifest entry grants nothing by
         itself. The real gate is the Usage Access special-access app op the
         user flips in Settings (ACTION_USAGE_ACCESS_SETTINGS), checked at
         runtime via AppOpsManager — see PresenceMonitor.hasUsageAccess. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>

    <!-- "Share heartbeat & steps" (kb/platform-android.md "Steps / heart
         rate") — Health Connect is where Galaxy Watch / Garmin / Pixel
         Watch / Amazfit all sync, so one integration covers every watch
         the couple might own. Off by default like every sharing opt-in;
         granted through Health Connect's own permission sheet, never a
         plain runtime dialog.

         READ_HEALTH_DATA_IN_BACKGROUND is what lets the foreground
         service read while Kehai is off screen — which is the normal case,
         since the background isolate owns the heartbeat then. It only
         exists on Android 14+ providers; older ones silently drop it from
         the sheet, and the feature degrades to "updates while the app is
         open", which is why the Kotlin side never treats it as required. -->
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE"/>
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"/>

    <!-- androidx.health.connect:connect-client is built against minSdk 26
         while Kehai targets 24. Overriding is safe rather than lazy:
         Health Connect needs Android 9 (API 28) on any device anyway, and
         KehaiVitalsPlugin checks Build.VERSION before touching a single
         Health Connect class, so on a 24/25 phone the library is never
         loaded and every vitals call answers "unavailable". -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client"/>

    <application
        android:label="Kehai"
        android:name=".KehaiApplication"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- flutter_foreground_task's service. Name is fixed by the
             package — do not rename.

             `location` is added alongside `specialUse` (multiple types are
             `|`-separated) so the background isolate's LocationPublisher
             can keep reporting fixes while backgrounded, when the user has
             opted into "share my location" and granted background
             location. specialUse still covers everything else this
             service does; location only applies while shareLocation is on
             (the publisher itself no-ops without it), so declaring the
             type doesn't change behaviour for anyone who leaves it off. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse|location"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="companion_presence: continuously reports this phone's battery, charging, screen and now-playing state to the paired partner's self-hosted server, and keeps the ongoing notification showing the partner's live status. The notification IS the feature; there is no bounded task to finish."/>
        </service>

        <!-- Enabled by the user in Settings > Notification access. We never
             read notifications: this component exists only because Android
             gates MediaSessionManager.getActiveSessions() behind an enabled
             listener. See KehaiNotificationListenerService. -->
        <!-- exported=true is required: the *system* binds this service from
             another process. It's safe because BIND_NOTIFICATION_LISTENER_SERVICE
             is a signature-level permission only the system holds, so no
             other app can reach it. -->
        <service
            android:name=".KehaiNotificationListenerService"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <!-- Home-screen widget showing the partner's live status — the
             signature "partner window" from design-language.md, shrunk to
             widget size. Reads whatever KehaiTaskHandler / HomeViewModel
             last wrote via home_widget (see partner_widget.dart); no
             interactive callbacks, tap just opens MainActivity. -->
        <receiver
            android:name=".widget.PartnerWidgetReceiver"
            android:exported="true"
            android:label="@string/partner_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/partner_widget_info"/>
        </receiver>

        <!-- Health Connect refuses to hand over health permissions unless
             the app exposes a rationale screen it can deep-link to. Two
             entry points for the same trivial dialog: the pre-Android-14
             providers (the Health Connect APK) use the androidx action
             below, Android 14+ (Health Connect in the platform) uses the
             VIEW_PERMISSION_USAGE alias underneath. -->
        <activity
            android:name=".HealthRationaleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>
        <!-- Guarded by START_VIEW_PERMISSION_USAGE, a signature permission
             only the system holds — so exported=true reaches the
             permissions UI and nobody else. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".HealthRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>

        <!-- Activity-aware status-bar icon set (Wave 6, kb/roadmap.md) —
             the ongoing notification's small icon changes with what the
             partner is doing (music/coding/scrolling/... — see
             lib/domain/notification_icon.dart). flutter_foreground_task's
             `NotificationIcon(metaDataName: ...)` resolves through
             `PackageManager.getApplicationInfo(..., GET_META_DATA)`, i.e. a
             manifest meta-data *int* keyed by name — not an arbitrary
             runtime resource-name lookup — so every drawable this app can
             pick at runtime needs its own entry here. The ten names below
             must stay in lockstep with
             `notification_icon.dart`'s `notificationIconNames` and
             `tool/generate_notification_icons.py`'s `ICONS` map. -->
        <meta-data android:name="ic_stat_heart" android:resource="@drawable/ic_stat_heart"/>
        <meta-data android:name="ic_stat_music" android:resource="@drawable/ic_stat_music"/>
        <meta-data android:name="ic_stat_code" android:resource="@drawable/ic_stat_code"/>
        <meta-data android:name="ic_stat_scroll" android:resource="@drawable/ic_stat_scroll"/>
        <meta-data android:name="ic_stat_watch" android:resource="@drawable/ic_stat_watch"/>
        <meta-data android:name="ic_stat_game" android:resource="@drawable/ic_stat_game"/>
        <meta-data android:name="ic_stat_chat" android:resource="@drawable/ic_stat_chat"/>
        <meta-data android:name="ic_stat_photo" android:resource="@drawable/ic_stat_photo"/>
        <meta-data android:name="ic_stat_sleep" android:resource="@drawable/ic_stat_sleep"/>
        <meta-data android:name="ic_stat_away" android:resource="@drawable/ic_stat_away"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Package visibility (API 30+): without this, getSdkStatus can't
             see the Health Connect APK on Android 13 and below and would
             report "unavailable" on phones that have it installed. -->
        <package android:name="com.google.android.apps.healthdata"/>
    </queries>
</manifest>
