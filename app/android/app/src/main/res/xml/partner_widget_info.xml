<?xml version="1.0" encoding="utf-8"?>
<!-- Default size ~4x2 cells (70dp*cols - 30dp), resizable down to ~2x1 and
     up to whatever the launcher's grid allows. Glance provides its own
     loading layout for the brief window before the first Compose pass. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/partner_widget_description"
    android:updatePeriodMillis="1800000">
</appwidget-provider>
